{"sha":"45f98143be706567f03b9e229d5ef8d43a2940f4","node_id":"C_kwDOApKUbdoAKDQ1Zjk4MTQzYmU3MDY1NjdmMDNiOWUyMjlkNWVmOGQ0M2EyOTQwZjQ","commit":{"author":{"name":"Aaditya1273","email":"aadityaiitian1515@gmail.com","date":"2026-09-01T17:13:12Z"},"committer":{"name":"Aman Agrawal","email":"amanagr@zulip.com","date":"2026-09-04T05:19:55Z"},"message":"users: Fix pipe-digit validation bypass in check_full_name.\n\nThe regex check that rejects names ending with `|<digits>` (to\nprevent ambiguity with Zulip's mention syntax) was applied to\n`full_name_raw` instead of the stripped `full_name`. Since `$`\nanchors to the end of the string, trailing whitespace like\n`\"User|15 \"` caused the regex to not match, but the function\nreturned the stripped `\"User|15\"` — the exact pattern the check\nwas designed to prevent.\n\nFix by checking the already-stripped `full_name`, consistent with\nevery other validation in the function.\n\nFixes #40062.","tree":{"sha":"07f7cd4f435dc1706f5971d2e1180c53c1ad8bc6","url":"https://api.github.com/repos/zulip/zulip/git/trees/07f7cd4f435dc1706f5971d2e1180c53c1ad8bc6"},"url":"https://api.github.com/repos/zulip/zulip/git/commits/45f98143be706567f03b9e229d5ef8d43a2940f4","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/zulip/zulip/commits/45f98143be706567f03b9e229d5ef8d43a2940f4","html_url":"https://github.com/zulip/zulip/commit/45f98143be706567f03b9e229d5ef8d43a2940f4","comments_url":"https://api.github.com/repos/zulip/zulip/commits/45f98143be706567f03b9e229d5ef8d43a2940f4/comments","author":{"login":"Aaditya1273","id":189955193,"node_id":"U_kgDOC1J8eQ","avatar_url":"https://avatars.githubusercontent.com/u/189955193?v=4","gravatar_id":"","url":"https://api.github.com/users/Aaditya1273","html_url":"https://github.com/Aaditya1273","followers_url":"https://api.github.com/users/Aaditya1273/followers","following_url":"https://api.github.com/users/Aaditya1273/following{/other_user}","gists_url":"https://api.github.com/users/Aaditya1273/gists{/gist_id}","starred_url":"https://api.github.com/users/Aaditya1273/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Aaditya1273/subscriptions","organizations_url":"https://api.github.com/users/Aaditya1273/orgs","repos_url":"https://api.github.com/users/Aaditya1273/repos","events_url":"https://api.github.com/users/Aaditya1273/events{/privacy}","received_events_url":"https://api.github.com/users/Aaditya1273/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"amanagr","id":25124304,"node_id":"MDQ6VXNlcjI1MTI0MzA0","avatar_url":"https://avatars.githubusercontent.com/u/25124304?v=4","gravatar_id":"","url":"https://api.github.com/users/amanagr","html_url":"https://github.com/amanagr","followers_url":"https://api.github.com/users/amanagr/followers","following_url":"https://api.github.com/users/amanagr/following{/other_user}","gists_url":"https://api.github.com/users/amanagr/gists{/gist_id}","starred_url":"https://api.github.com/users/amanagr/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/amanagr/subscriptions","organizations_url":"https://api.github.com/users/amanagr/orgs","repos_url":"https://api.github.com/users/amanagr/repos","events_url":"https://api.github.com/users/amanagr/events{/privacy}","received_events_url":"https://api.github.com/users/amanagr/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8b8ccfbe79853488760c51f0f820295b279ad40b","url":"https://api.github.com/repos/zulip/zulip/commits/8b8ccfbe79853488760c51f0f820295b279ad40b","html_url":"https://github.com/zulip/zulip/commit/8b8ccfbe79853488760c51f0f820295b279ad40b"}],"stats":{"total":7,"additions":6,"deletions":1},"files":[{"sha":"cda2e9020adc0b46798f953529f9292f68421f92","filename":"zerver/lib/users.py","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/zulip/zulip/blob/45f98143be706567f03b9e229d5ef8d43a2940f4/zerver%2Flib%2Fusers.py","raw_url":"https://github.com/zulip/zulip/raw/45f98143be706567f03b9e229d5ef8d43a2940f4/zerver%2Flib%2Fusers.py","contents_url":"https://api.github.com/repos/zulip/zulip/contents/zerver%2Flib%2Fusers.py?ref=45f98143be706567f03b9e229d5ef8d43a2940f4","patch":"@@ -67,7 +67,7 @@ def check_full_name(\n     # sloppily-written parsers of our Markdown syntax for mentioning\n     # users with ambiguous names, and likely have no real use, so we\n     # ban them.\n-    if re.search(r\"\\|\\d+$\", full_name_raw):\n+    if re.search(r\"\\|\\d+$\", full_name):\n         raise JsonableError(_(\"Invalid format!\"))\n \n     if require_unique_names(realm):"},{"sha":"c28c733d5b4625cbe3bc68be112dc12a4b6ffafb","filename":"zerver/tests/test_users.py","status":"modified","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/zulip/zulip/blob/45f98143be706567f03b9e229d5ef8d43a2940f4/zerver%2Ftests%2Ftest_users.py","raw_url":"https://github.com/zulip/zulip/raw/45f98143be706567f03b9e229d5ef8d43a2940f4/zerver%2Ftests%2Ftest_users.py","contents_url":"https://api.github.com/repos/zulip/zulip/contents/zerver%2Ftests%2Ftest_users.py?ref=45f98143be706567f03b9e229d5ef8d43a2940f4","patch":"@@ -487,6 +487,11 @@ def test_not_allowed_format(self) -> None:\n         result = self.client_patch(\"/json/users/{}\".format(self.example_user(\"hamlet\").id), req)\n         self.assert_json_error(result, \"Invalid format!\")\n \n+        # Trailing whitespace should not bypass the pipe-digit check\n+        req = dict(full_name=\"iago|72 \")\n+        result = self.client_patch(\"/json/users/{}\".format(self.example_user(\"hamlet\").id), req)\n+        self.assert_json_error(result, \"Invalid format!\")\n+\n     def test_allowed_format_complex(self) -> None:\n         # Adding characters after r'|d+' doesn't break Markdown\n         new_name = \"Hello- 12iago|72k\""}]}
